# =====================================================================
# Hospital Management System (HMS) — Backend Environment Variables
# Copy this file to .env and configure with your local settings.
# NEVER commit the actual .env file to version control!
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hms_db
DB_CONNECTION_LIMIT=10

# Security & Authentication (JWT)
JWT_SECRET=super_secret_hospital_jwt_signing_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=8h

# CORS Configuration (Client URL)
CLIENT_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10
