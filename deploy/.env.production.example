# ==============================================================================
# Hospital Management System (HMS) - Production Environment Profile
# Place this file as `.env` inside the `backend/` directory on the production server.
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# MySQL Production Database Connection (Managed RDS / Cluster)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hms_prod_user
DB_PASSWORD=ReplaceWithStrongProductionPassword_123!
DB_NAME=hms_db
DB_CONNECTION_LIMIT=25

# Cryptographic & Security Keys (Generate via: openssl rand -base64 48)
JWT_SECRET=prod_super_secure_cryptographic_jwt_signing_key_at_least_64_characters_long_9283719283
JWT_EXPIRES_IN=8h

# CORS Whitelist (Production Domain)
CLIENT_URL=https://hospital.yourdomain.com

# File Storage Configuration
UPLOAD_DIR=/var/www/hms/uploads
MAX_FILE_SIZE_MB=10
